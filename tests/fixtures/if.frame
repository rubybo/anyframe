<script>
  import { state } from "anyframe";
  const show = state(true);
  function hide() { show.set(false); }
  function appear() { show.set(true); }
</script>
{#if show}
  <p class="yes">yes</p>
{:else}
  <p class="no">no</p>
{/if}
<button type="button" on:click={hide}>Hide</button>
<button type="button" on:click={appear}>Show</button>
